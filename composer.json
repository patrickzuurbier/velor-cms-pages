{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "patrickzuurbier/velor-cms-pages",
    "description": "Pages and paragraphs resource plugin for Velor CMS.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "velor/cms": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Velor\\Pages\\": "src/",
            "Velor\\Pages\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Velor\\Pages\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Velor\\Pages\\Providers\\PagesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
